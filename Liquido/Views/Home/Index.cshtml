@model IEnumerable<Liquido.ViewModels.Products.ProductVM>
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section text-white">
    <div class="container position-relative">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <p class="text-info fw-semibold mb-2 text-uppercase"
                   style="letter-spacing:2px; font-size:0.9rem;">
                    Pure · Natural · Delivered
                </p>
                <h1 class="mb-3">
                    Every Drop,<br />
                    <span style="color: var(--liquido-cyan);">Delivered.</span>
                </h1>
                <p class="mb-4">
                    Premium water and beverages delivered straight to your door.
                    Stay hydrated with Bulgaria's finest natural springs.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-info text-dark fw-bold px-4 py-2">
                        <i class="bi bi-grid me-2"></i>Shop Now
                    </a>
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-outline-light px-4 py-2">
                        Get Started
                    </a>
                </div>
            </div>

            <div class="col-lg-6 d-none d-lg-flex
                        justify-content-center align-items-center">
                <div class="text-center" style="opacity: 0.15;">
                    <i class="bi bi-droplet-fill"
                       style="font-size: 18rem; color: var(--liquido-cyan);"></i>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model != null && Model.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="section-title">Featured Products</h2>
                    <p class="text-muted mt-3 mb-0">
                        Our most popular picks, handpicked for you
                    </p>
                </div>
                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-primary d-none d-md-inline-flex
                              align-items-center gap-2">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var product in Model)
                {
                    <div class="col-sm-6 col-lg-4">
                        @await Html.PartialAsync("_ProductCard", product)
                    </div>
                }
            </div>

            <div class="text-center mt-4 d-md-none">
                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    View All Products
                </a>
            </div>
        </div>
    </section>
}

<section class="py-5" style="background-color: var(--liquido-gray);">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title d-inline-block">Why Choose Liquido?</h2>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="p-4">
                    <div class="mb-3">
                        <i class="bi bi-award-fill fs-1"
                           style="color: var(--liquido-blue);"></i>
                    </div>
                    <h5 class="fw-bold">Certified Quality</h5>
                    <p class="text-muted mb-0">
                        All our water sources are certified and tested
                        regularly to meet the highest purity standards.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <div class="mb-3">
                        <i class="bi bi-truck fs-1"
                           style="color: var(--liquido-blue);"></i>
                    </div>
                    <h5 class="fw-bold">Next-Day Delivery</h5>
                    <p class="text-muted mb-0">
                        Order before 3pm and receive your delivery
                        the very next working day.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <div class="mb-3">
                        <i class="bi bi-gift fs-1"
                           style="color: var(--liquido-blue);"></i>
                    </div>
                    <h5 class="fw-bold">Loyalty Rewards</h5>
                    <p class="text-muted mb-0">
                        Earn points on every purchase and redeem them
                        for discounts on future orders.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>