@model Liquido.ViewModels.Cart.CartVM
@{
    ViewData["Title"] = "My Cart";
}

<section class="py-5">
    <div class="container">

        <h2 class="fw-bold mb-4">
            <i class="bi bi-cart3 me-2 text-primary"></i>My Cart
        </h2>

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-circle me-2"></i>@error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-2"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.IsEmpty)
        {
            <div class="text-center py-5">
                <i class="bi bi-cart-x"
                   style="font-size:5rem; color:var(--liquido-blue); opacity:0.2;"></i>
                <h4 class="mt-3 text-muted">Your cart is empty</h4>
                <p class="text-muted">Add some products to get started!</p>
                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-liquido mt-2">
                    <i class="bi bi-grid me-2"></i>Browse Products
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-liquido">
                        <div class="card-body p-0">
                            <table class="table cart-table mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Product</th>
                                        <th class="text-center">Price</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-center">Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr class="align-middle">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center gap-3">
                                                    @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                                    {
                                                        <img src="@item.ProductImageUrl"
                                                             alt="@item.ProductName"
                                                             class="rounded"
                                                             style="width:55px;height:55px;object-fit:cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded bg-light d-flex
                                                                                align-items-center
                                                                                justify-content-center"
                                                             style="width:55px;height:55px;">
                                                            <i class="bi bi-droplet text-primary"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <div class="fw-semibold">
                                                            @item.ProductName
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(item.Volume))
                                                        {
                                                            <small class="text-muted">
                                                                @item.Volume
                                                            </small>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                @item.Price.ToString("F2") euro.
                                            </td>
                                            <td class="text-center">
                                                <form asp-action="Update"
                                                      method="post"
                                                      class="d-inline-flex align-items-center gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden"
                                                           name="cartItemId"
                                                           value="@item.CartItemId" />
                                                    <input type="number"
                                                           name="quantity"
                                                           value="@item.Quantity"
                                                           min="1"
                                                           max="@item.MaxQuantity"
                                                           class="form-control form-control-sm qty-input"
                                                           onchange="this.form.submit()" />
                                                </form>
                                            </td>
                                            <td class="text-center fw-semibold"
                                                style="color:var(--liquido-blue);">
                                                @item.SubTotal.ToString("F2") euro.
                                            </td>
                                            <td class="text-center">
                                                <form asp-action="Remove" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden"
                                                           name="cartItemId"
                                                           value="@item.CartItemId" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger border-0"
                                                            data-confirm="Remove this item?">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                        </a>
                        <form asp-action="Clear" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-outline-danger"
                                    data-confirm="Clear your entire cart?">
                                <i class="bi bi-trash me-2"></i>Clear Cart
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-liquido p-4">
                        <h5 class="fw-bold mb-4">Order Summary</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">
                                Items (@Model.TotalItems)
                            </span>
                            <span>@Model.TotalPrice.ToString("F2") euro.</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Delivery</span>
                            <span class="text-success">Free</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted"
                             style="font-size:0.85rem;">
                            <span>Loyalty points earned</span>
                            <span>+@((int)Math.Floor(Model.TotalPrice)) pts</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-4">
                            <strong>Total</strong>
                            <strong style="color:var(--liquido-blue); font-size:1.2rem;">
                                @Model.TotalPrice.ToString("F2") euro.
                            </strong>
                        </div>

                        <a asp-controller="Orders"
                           asp-action="Checkout"
                           class="btn btn-liquido w-100 py-2">
                            <i class="bi bi-credit-card me-2"></i>Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
