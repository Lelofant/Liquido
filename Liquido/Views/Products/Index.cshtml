@model Liquido.ViewModels.Products.ProductListVM
@{
    ViewData["Title"] = "Products";
}

<section class="py-5">
    <div class="container">
        <div class="row g-4">

            <div class="col-lg-3">
                <div class="card border-0 shadow-sm rounded-liquido p-3">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-funnel me-2 text-primary"></i>Filter Products
                    </h6>

                    <form asp-action="Index" method="get" id="filterForm">

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Search</label>
                            <input type="text"
                                   name="searchTerm"
                                   value="@Model.SearchTerm"
                                   class="form-control form-control-sm"
                                   placeholder="Search products..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Category</label>
                            <select name="categoryId" class="form-select form-select-sm">
                                <option value="">All Categories</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">
                                        @cat.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Price Range (BGN)</label>
                            <div class="d-flex gap-2">
                                <input type="number"
                                       name="minPrice"
                                       value="@Model.MinPrice"
                                       class="form-control form-control-sm"
                                       placeholder="Min"
                                       min="0"
                                       step="0.01" />
                                <input type="number"
                                       name="maxPrice"
                                       value="@Model.MaxPrice"
                                       class="form-control form-control-sm"
                                       placeholder="Max"
                                       min="0"
                                       step="0.01" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-liquido btn-sm w-100">
                            <i class="bi bi-search me-1"></i>Apply Filters
                        </button>

                        @if (Model.SearchTerm != null || Model.CategoryId != null
                             || Model.MinPrice != null || Model.MaxPrice != null)
                        {
                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-sm w-100 mt-2">
                                <i class="bi bi-x me-1"></i>Clear Filters
                            </a>
                        }
                    </form>
                </div>
            </div>

            <div class="col-lg-9">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-0">
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <span>Results for "@Model.SearchTerm"</span>
                            }
                            else
                            {
                                <span>All Products</span>
                            }
                        </h4>
                        <small class="text-muted">@Model.TotalCount products found</small>
                    </div>
                </div>

                @if (!Model.Products.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search"
                           style="font-size:4rem; color:var(--liquido-blue); opacity:0.2;"></i>
                        <h5 class="mt-3 text-muted">No products found</h5>
                        <p class="text-muted">Try adjusting your filters</p>
                        <a asp-action="Index" class="btn btn-outline-primary mt-2">
                            Clear Filters
                        </a>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-sm-6 col-xl-4">
                                @await Html.PartialAsync("_ProductCard", product)
                            </div>
                        }
                    </div>

                    @await Html.PartialAsync("_Pagination", Model)
                }
            </div>
        </div>
    </div>
</section>


