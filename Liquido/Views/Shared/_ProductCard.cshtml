@model Liquido.ViewModels.Products.ProductVM

<div class="card product-card h-100">

    <a asp-controller="Products"
       asp-action="Details"
       asp-route-id="@Model.Id">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="@Model.Name"
                 class="card-img-top" />
        }
        else
        {
            <div class="card-img-top d-flex align-items-center
                            justify-content-center bg-light"
                 style="height:200px;">
                <i class="bi bi-droplet text-primary"
                   style="font-size:4rem; opacity:0.3;"></i>
            </div>
        }
    </a>

    <div class="card-body d-flex flex-column">

        <span class="badge bg-light text-primary border border-primary
                     mb-2 align-self-start"
              style="font-size:0.75rem;">
            @Model.CategoryName
        </span>

        <h6 class="card-title fw-semibold mb-1">
            <a asp-controller="Products"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="text-dark text-decoration-none stretched-link">
                @Model.Name
            </a>
        </h6>

        @if (!string.IsNullOrEmpty(Model.Volume))
        {
            <small class="text-muted mb-2">@Model.Volume</small>
        }

        @if (Model.ReviewCount > 0)
        {
            <div class="star-rating mb-2">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(Model.AverageRating))
                    {
                        <i class="bi bi-star-fill"></i>
                    }
                    else
                    {
                        <i class="bi bi-star empty"></i>
                    }
                }
                <small class="text-muted ms-1">(@Model.ReviewCount)</small>
            </div>
        }

        <div class="mt-auto d-flex justify-content-between align-items-center">

            <span class="price-tag">@Model.Price.ToString("F2") euro.</span>

            @if (!Model.InStock)
            {
                <span class="badge-stock-out">Out of Stock</span>
            }
            else
            {
                <span class="badge bg-success-subtle text-success
                                 border border-success"
                      style="font-size:0.75rem;">
                    In Stock
                </span>
            }
        </div>
    </div>
</div>