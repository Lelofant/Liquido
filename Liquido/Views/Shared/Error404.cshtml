@{
    ViewData["Title"] = "Page Not Found";
}
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <div class="mb-3"
                     style="font-size: 8rem;
                            font-weight: 900;
                            color: var(--liquido-blue);
                            opacity: 0.15;
                            line-height: 1;">
                    404
                </div>
                <div class="mb-4" style="margin-top: -2rem;">
                    <i class="bi bi-droplet"
                       style="font-size: 4rem;
                              color: var(--liquido-blue);"></i>
                </div>
                <h1 class="fw-bold mb-2" style="font-size: 1.8rem;">
                    Page Not Found
                </h1>
                <p class="text-muted mb-4">
                    Looks like this page has dried up.
                    The page you are looking for does not exist or
                    has been moved.
                </p>
                <div class="d-flex gap-3 justify-content-center">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-liquido">
                        <i class="bi bi-house me-2"></i>Go Home
                    </a>
                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        <i class="bi bi-grid me-2"></i>Browse Products
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>