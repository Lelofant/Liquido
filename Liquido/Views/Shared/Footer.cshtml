<footer>
    <div class="container">
        <div class="row g-4 pb-4">

            <div class="col-lg-4">
                <div class="footer-brand d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-droplet-fill text-info fs-4"></i>
                    <span>Liquido</span>
                </div>
                <p class="mb-0" style="font-size: 0.9rem;">
                    Every drop, delivered. Pure water and premium
                    beverages brought straight to your door.
                </p>
            </div>

            <div class="col-6 col-lg-2 offset-lg-1">
                <h6 class="text-white fw-semibold mb-3">Quick Links</h6>
                <ul class="list-unstyled mb-0" style="font-size: 0.9rem;">
                    <li class="mb-2">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="mb-2">
                        <a asp-controller="Products" asp-action="Index">Products</a>
                    </li>
                    <li class="mb-2">
                        <a asp-controller="Home" asp-action="About">About Us</a>
                    </li>
                </ul>
            </div>

            <div class="col-6 col-lg-2">
                <h6 class="text-white fw-semibold mb-3">Account</h6>
                <ul class="list-unstyled mb-0" style="font-size: 0.9rem;">
                    <li class="mb-2">
                        <a asp-controller="Account" asp-action="Login">Login</a>
                    </li>
                    <li class="mb-2">
                        <a asp-controller="Account" asp-action="Register">Register</a>
                    </li>
                    <li class="mb-2">
                        <a asp-controller="Orders" asp-action="MyOrders">My Orders</a>
                    </li>
                </ul>
            </div>

           
        </div>

        <hr />

        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-center
                    pt-2 pb-1"
             style="font-size: 0.85rem;">
            <span>&copy; @DateTime.Now.Year Liquido. All rights reserved.</span>
            <span class="mt-2 mt-md-0">
                Made with <i class="bi bi-heart-fill text-danger"></i> in Bulgaria
            </span>
        </div>
    </div>
</footer>

