@using Microsoft.AspNetCore.Identity
@using Liquido.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Liquido.Services.Interfaces.ICartService CartService

@{
    var cartCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var userId = UserManager.GetUserId(User)!;
        cartCount = await CartService.GetItemCountAsync(userId);
    }

    var isAdmin = User.IsInRole("Admin");
}

<nav class="navbar navbar-expand-lg sticky-top" id="mainNavbar">
    <div class="container">

        <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
           asp-controller="Home" asp-action="Index">
            <i class="bi bi-droplet-fill text-info fs-4"></i>
            <span>Liquido</span>
        </a>

        <button class="navbar-toggler border-0"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">

            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Products" asp-action="Index">
                        Products
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="About">
                        About
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-1">

                @if (SignInManager.IsSignedIn(User))
                {
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold"
                               asp-area="Admin"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                <i class="bi bi-shield-lock-fill me-1"></i>Admin
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link position-relative px-2"
                           asp-controller="Cart"
                           asp-action="Index"
                           title="My Cart">
                            <i class="bi bi-cart3 fs-5"></i>
                            @if (cartCount > 0)
                            {
                                <span class="position-absolute top-0 start-100
                                                             translate-middle badge rounded-pill
                                                             bg-info text-dark"
                                      id="cartBadge">
                                    @cartCount
                                </span>
                            }
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-1"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="d-none d-lg-inline">
                                @UserManager.GetUserName(User)
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="Profile">
                                    <i class="bi bi-person me-2 text-primary"></i>
                                    My Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Orders"
                                   asp-action="MyOrders">
                                    <i class="bi bi-bag me-2 text-primary"></i>
                                    My Orders
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-info btn-sm text-dark fw-semibold ms-1"
                           asp-controller="Account"
                           asp-action="Register">
                            Register
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<div class="toast-container" id="toastContainer"></div>