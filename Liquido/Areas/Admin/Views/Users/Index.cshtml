@model IEnumerable<Liquido.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm rounded-liquido">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Email</th>
                        <th>Registered</th>
                        <th>Points</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="align-middle">
                            <td class="ps-4">
                                @user.FirstName @user.LastName
                            </td>
                            <td>@user.Email</td>
                            <td>@user.RegisteredAt.ToString("dd MMM yyyy")</td>
                            <td>@user.LoyaltyPoints</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <form asp-area="Admin"
                                      asp-controller="Users"
                                      asp-action="ToggleActive"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit"
                                            class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            data-confirm="@(user.IsActive ? "Deactivate this user?" : "Activate this user?")">
                                        @(user.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
